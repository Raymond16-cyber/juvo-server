# Paystack server credentials. Never expose this key to the client or commit a real value.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_BILLING_CURRENCY=NGN
PAYSTACK_PRO_MONTHLY_PLAN_CODE=PLN_replace_with_pro_monthly_plan_code
PAYSTACK_SUPER_MONTHLY_PLAN_CODE=PLN_replace_with_super_monthly_plan_code

# The Paystack hosted checkout returns here. Use HTTPS outside local development.
PAYSTACK_CALLBACK_URL=http://localhost:3000/home/general/subscriptions
