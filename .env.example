# Paystack server credentials. Never expose these keys to the client or commit real values.
PAYSTACK_MODE=test
PAYSTACK_TEST_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_LIVE_SECRET_KEY=sk_live_replace_with_your_paystack_secret_key
PAYSTACK_BILLING_CURRENCY=NGN
PAYSTACK_TEST_PRO_MONTHLY_PLAN_CODE=PLN_replace_with_test_pro_monthly_plan_code
PAYSTACK_TEST_SUPER_MONTHLY_PLAN_CODE=PLN_replace_with_test_super_monthly_plan_code
PAYSTACK_PRO_MONTHLY_PLAN_CODE=PLN_replace_with_live_pro_monthly_plan_code
PAYSTACK_SUPER_MONTHLY_PLAN_CODE=PLN_replace_with_live_super_monthly_plan_code

# The Paystack hosted checkout returns here. Use HTTPS outside local development.
PAYSTACK_CALLBACK_URL=http://localhost:3000/home/general/subscriptions
